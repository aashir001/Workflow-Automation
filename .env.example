# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed - this file (.env.example)
# is the only one that should ever be pushed to a public repository.

# Required for real LLM-based natural-language workflow parsing.
# Without this, the natural-language builder falls back to a
# deterministic keyword-based parser (see app/nl_builder.py).
GROQ_API_KEY=

# Required to keep credentials saved via the Credentials tab (Slack,
# email, WhatsApp, Google) readable across app restarts. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this, a random key is generated each run and saved credentials
# become unreadable after every restart.
CREDENTIAL_ENCRYPTION_KEY=

# All other credentials (Slack webhook, Twilio, Gmail SMTP, Google service
# account) are meant to be entered through the app's Credentials tab at
# runtime, encrypted, and stored in the database - NOT placed here. See
# SETUP_CHECKLIST.md for exact steps for each one.
