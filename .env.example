# Copy this file to .env and fill in your real values. .env is gitignored.

# Optional - enables real LLM-based natural-language workflow parsing.
# Without it, the natural-language builder falls back to a deterministic
# keyword-based parser (see app/nl_builder.py).
GROQ_API_KEY=

# Required to keep credentials saved via the Credentials page readable
# across backend restarts. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# All other credentials (Slack webhook, Twilio, Gmail SMTP, Google service
# account) are entered through the app's Credentials page at runtime,
# encrypted, and stored in the database - not placed here.
